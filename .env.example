# ---------------------------------------------------------------------------
# SupplierClarity AI — local environment
# Copy to .env, fill in what you need, then:
#   node --env-file=.env server/index.mjs
# Never commit real keys: .env is git-ignored.
# ---------------------------------------------------------------------------

# ---- Clarity Assistant (chatbot) — server-side keys only -------------------
# Groq (https://console.groq.com) — tried first when both keys are set.
GROQ_API_KEY=
# Optional Groq model override. Default: openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
# Optional Gemini model override. Default: gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Optional: force one provider. Values: groq | gemini | auto (default auto)
# CHAT_PROVIDER=auto

# ---- Enhancement engine ----------------------------------------------------
# Interpreter that has ncnn + numpy + pillow installed. Leave empty to let the
# server find .venv/bin/python, python3 or python automatically.
# ENHANCE_PYTHON=.venv/bin/python
# Worker threads. Empty = cores - 1.
# ENHANCE_THREADS=2

# ---- API limits ------------------------------------------------------------
# PORT=8787
# MAX_UPLOAD_BYTES=12582912
# MAX_INPUT_PIXELS=1600000
# MAX_QUEUE=24
# JOB_TTL_MS=7200000
# RATE_LIMIT_PER_MIN=15
