# Clarity Assistant (bottom-right chatbot) — server-side keys only.
# Copy to .env for local Express runs, or set these in Vercel:
# Project Settings > Environment Variables, then redeploy.
# Never commit real keys. Keys are never exposed to the browser.

# Groq (https://console.groq.com) — used first when both keys are set.
GROQ_API_KEY=
# Optional Groq model override. Default: openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
# Optional Gemini model override. Default: gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Optional: force one provider. Values: groq | gemini | auto (default auto)
# CHAT_PROVIDER=auto
